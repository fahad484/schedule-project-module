# PostgreSQL connection string. Neon connection strings should use SSL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/medinest
DATABASE_SSL=false

# Use a random secret with at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Required to register doctor accounts; share only with approved clinicians.
DOCTOR_SIGNUP_CODE=replace-with-a-private-invitation-code

# Comma-separated frontend origins allowed to use cookie sessions.
FRONTEND_URL=http://localhost:3000

PORT=3001
NODE_ENV=development
