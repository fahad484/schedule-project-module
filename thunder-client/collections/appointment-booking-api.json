      "colId": "col_appointment_booking_api",
      "containerId": "f_appointments",
      "name": "5.2 Book Appointment (Patient)",
      "url": "{{baseUrl}}/api/v1/appointments",
      "method": "POST",
      "body": {
        "type": "json",
        "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"appointmentDate\": \"2026-11-05\",\n  \"startTime\": \"09:00\",\n  \"endTime\": \"09:30\",\n  \"reason\": \"Routine health checkup and consultation\"\n}"
      }
    },
    {
      "_id": "req_apts_double_booking_test",
      "colId": "col_appointment_booking_api",
      "containerId": "f_appointments",
      "name": "5.3 Test Double-Booking Prevention (Expected 409/400)",
      "url": "{{baseUrl}}/api/v1/appointments",
      "method": "POST",
      "body": {
        "type": "json",
        "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"appointmentDate\": \"2026-11-05\",\n  \"startTime\": \"09:00\",\n  \"endTime\": \"09:30\",\n  \"reason\": \"Concurrent collision test request\"\n}"
      }
    },
    {
      "_id": "req_apts_get_single",
      "colId": "col_appointment_booking_api",
      "containerId": "f_appointments",
      "name": "5.4 Get Appointment Details By ID",
      "url": "{{baseUrl}}/api/v1/appointments/{{appointmentId}}",
      "method": "GET"
    },
    {
      "_id": "req_apts_reschedule",
      "colId": "col_appointment_booking_api",
      "containerId": "f_appointments",
      "name": "5.5 Reschedule Appointment",
      "url": "{{baseUrl}}/api/v1/appointments/{{appointmentId}}/reschedule",
