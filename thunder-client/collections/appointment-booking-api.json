      "method": "POST",
      "body": {
        "type": "json",
        "raw": "{\n  \"reason\": \"Schedule conflict; requested cancellation\"\n}"
      }
    },
    {
      "_id": "req_reviews_create",
      "colId": "col_appointment_booking_api",
