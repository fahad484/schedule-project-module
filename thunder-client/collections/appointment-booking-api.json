  "requests": [
    {
      "_id": "req_auth_signup",
      "colId": "col_appointment_booking_api",
      "containerId": "f_auth",
      "name": "1.1 Sign Up (Patient)",
      "url": "{{baseUrl}}/api/auth/sign-up",
      "method": "POST",
      "body": {
        "type": "json",
        "raw": "{\n  \"name\": \"Alex Patient\",\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{patientPassword}}\",\n  \"role\": \"patient\",\n  \"phone\": \"+1-555-0101\"\n}"
      }
    },
    {
      "_id": "req_auth_signin_patient",
      "colId": "col_appointment_booking_api",
      "containerId": "f_auth",
      "name": "1.2 Sign In (Patient)",
      "url": "{{baseUrl}}/api/auth/sign-in",
      "method": "POST",
      "body": {
        "type": "json",
        "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{patientPassword}}\"\n}"
      }
    },
    {
      "_id": "req_auth_signin_doctor",
      "colId": "col_appointment_booking_api",
      "containerId": "f_auth",
      "name": "1.3 Sign In (Doctor)",
      "url": "{{baseUrl}}/api/auth/sign-in",
      "method": "POST",
      "body": {
        "type": "json",
        "raw": "{\n  \"email\": \"{{doctorEmail}}\",\n  \"password\": \"{{doctorPassword}}\"\n}"
      }
    },
    {
      "_id": "req_auth_signin_admin",
      "colId": "col_appointment_booking_api",
      "containerId": "f_auth",
      "name": "1.4 Sign In (Admin)",
      "url": "{{baseUrl}}/api/auth/sign-in",
      "method": "POST",
      "body": {
        "type": "json",
        "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
      }
    },
    {
      "_id": "req_auth_session",
      "colId": "col_appointment_booking_api",
      "containerId": "f_auth",
      "name": "1.5 Get Current Session",
      "url": "{{baseUrl}}/api/auth/get-session",
      "method": "GET"
    },
    {
      "_id": "req_auth_signout",
      "colId": "col_appointment_booking_api",
      "containerId": "f_auth",
      "name": "1.6 Sign Out",
      "url": "{{baseUrl}}/api/auth/sign-out",
