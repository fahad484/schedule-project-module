      "body": {
        "type": "json",
        "raw": "{\n  \"appointmentDate\": \"2026-11-06\",\n  \"startTime\": \"10:00\",\n  \"endTime\": \"10:30\"\n}"
      }
    },
    {
      "_id": "req_apts_confirm",
      "colId": "col_appointment_booking_api",
      "containerId": "f_appointments",
