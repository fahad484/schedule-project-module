      "body": {
        "type": "json",
        "raw": "{\n  \"name\": \"Cardiology & Vascular Care\",\n  \"description\": \"Comprehensive cardiac and vascular medical support\",\n  \"icon\": \"HeartPulse\"\n}"
      }
    },
    {
