      "colId": "col_appointment_booking_api",
      "containerId": "f_doctors_public",
      "name": "3.1 Search Doctors",
      "url": "{{baseUrl}}/api/v1/doctors?search=&page=1&limit=10",
      "method": "GET"
    },
    {
      "_id": "req_docs_filter_specialty",
      "colId": "col_appointment_booking_api",
      "containerId": "f_doctors_public",
      "name": "3.2 Filter Doctors by Specialty",
      "url": "{{baseUrl}}/api/v1/doctors?specialtyId={{specialtyId}}&page=1&limit=10",
      "method": "GET"
    },
    {
      "_id": "req_docs_get_single",
