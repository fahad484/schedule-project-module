      "url": "{{baseUrl}}/api/v1/doctors/profile",
      "method": "PUT",
      "body": {
        "type": "json",
        "raw": "{\n  \"consultationFee\": 150,\n  \"bio\": \"Senior Cardiologist with 12+ years of surgical experience.\",\n  \"isAcceptingPatients\": true\n}"
      }
    },
    {
      "_id": "req_docmgmt_avail_add",
      "colId": "col_appointment_booking_api",
      "containerId": "f_doctor_mgmt",
      "name": "4.3 Add Availability Shift",
      "url": "{{baseUrl}}/api/v1/doctors/availability",
      "method": "POST",
      "body": {
        "type": "json",
        "raw": "{\n  \"dayOfWeek\": \"monday\",\n  \"startTime\": \"09:00\",\n  \"endTime\": \"17:00\",\n  \"slotDurationMinutes\": 30\n}"
      }
    },
    {
      "_id": "req_apts_list",
      "colId": "col_appointment_booking_api",
      "containerId": "f_appointments",
      "name": "5.1 List Current User Appointments",
      "url": "{{baseUrl}}/api/v1/appointments?status=all",
      "method": "GET"
    },
    {
