      "url": "{{baseUrl}}/api/v1/specialties",
      "method": "POST",
      "body": {
        "type": "json",
        "raw": "{\n  \"name\": \"Neurology\",\n  \"description\": \"Brain and nervous system healthcare\",\n  \"icon\": \"Brain\"\n}"
      }
    },
    {
      "_id": "req_specs_update",
      "colId": "col_appointment_booking_api",
      "containerId": "f_specialties",
      "name": "2.4 Update Specialty (Admin Only)",
      "url": "{{baseUrl}}/api/v1/specialties/{{specialtyId}}",
